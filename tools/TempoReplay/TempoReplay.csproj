<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replays FRACTAL_AUDIO_DUMP frame dumps through the app's own beat pipeline (the source files
       below are compiled in directly, not copied) and scores the tempo against known BPMs. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Audio\BandLayout.cs" Link="Audio\BandLayout.cs" />
    <Compile Include="..\..\Audio\BeatPipeline.cs" Link="Audio\BeatPipeline.cs" />
    <Compile Include="..\..\Audio\OnsetDetector.cs" Link="Audio\OnsetDetector.cs" />
    <Compile Include="..\..\Audio\TempoTracker.cs" Link="Audio\TempoTracker.cs" />
  </ItemGroup>

</Project>
